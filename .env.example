# Copie este arquivo para .env.local e preencha. Nunca faça commit do .env.local.
#
# Sem nenhuma variável, o site funciona em modo local: conteúdo em storage/content.json
# e uploads em storage/uploads.

# ---------------------------------------------------------------------------
# Banco de dados (Supabase / PostgreSQL)
# ---------------------------------------------------------------------------
# No Supabase: Project Settings → Database → Connection string → URI.
# Use o "Transaction pooler" (porta 6543) para hospedagem serverless (Vercel, Netlify…)
# ou o "Session pooler" (porta 5432) para um servidor Node tradicional.
# ATENÇÃO: se a senha tiver "$", escreva "\$" (o carregador de .env expande $VARIAVEIS).
# DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:6543/postgres

# Conexões simultâneas por instância (padrão 5). Em serverless, 1–3 costuma bastar.
# DATABASE_POOL_MAX=5

# TLS é exigido automaticamente fora do localhost. "disable" desliga (apenas Postgres local sem TLS).
# DATABASE_SSL=disable

# ---------------------------------------------------------------------------
# Arquivos enviados pelo CMS (Supabase Storage)
# ---------------------------------------------------------------------------
# Project Settings → API. A service_role key dá acesso total: use SOMENTE no servidor.
# SUPABASE_URL=https://SEU_PROJETO.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=
# SUPABASE_STORAGE_BUCKET=media

# ---------------------------------------------------------------------------
# Sessão do painel
# ---------------------------------------------------------------------------
# Recomendado em produção: string longa e aleatória (ex.: `openssl rand -hex 32`).
# Se mudar, todas as sessões abertas são encerradas.
# SESSION_SECRET=

# ---------------------------------------------------------------------------
# Modo local (sem DATABASE_URL)
# ---------------------------------------------------------------------------
# STORAGE_DIR=./storage

# Permite login em produção sem HTTPS (apenas para testes)
# INSECURE_COOKIES=1
