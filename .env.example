# Pasta onde ficam content.json e uploads/ (padrão: ./storage)
# STORAGE_DIR=./storage

# Segredo usado para assinar a sessão do CMS ao criar o banco pela primeira vez
# SESSION_SECRET=troque-por-uma-string-longa-e-aleatoria

# Permite login em produção sem HTTPS (apenas para testes locais)
# INSECURE_COOKIES=1
